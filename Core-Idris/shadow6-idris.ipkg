package shadow6-idris

version = 1.1.0
authors = "Shadow6 Project"
license = "Proprietary"

sourcedir = "src"
builddir = "obj"

depends = base >= 0.6.0
        , contrib
        , network

modules = Shadow6.Types
        , Shadow6.Security
        , Shadow6.Crypto
        , Shadow6.Protocol
        , Shadow6.Features
        , Main

main = Main
executable = shadow6-idris

-- Compiler options
opts = "--cg chez"
