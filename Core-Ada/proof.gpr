project Proof is
   for Source_Dirs use ("src");
   for Source_Files use ("cells.ads", "cells.adb", "domain_policy.ads", "domain_policy.adb");
   for Object_Dir use "obj/proof";
   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2012", "-gnata", "-gnato");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=20", "--checks-as-errors=on", "--report=all");
   end Prove;
end Proof;
